<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="icon" type="image/png" href="https://welldoneconstruction.link/wp-content/uploads/2025/11/well-done-construction-favicon.png">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Activity Log | Admin Audit</title>
  <style>
    :root { --primary: #343E47; --accent: #33B26E; --bg: #f4f7f6; }
    body { font-family: -apple-system, sans-serif; background: var(--bg); margin: 0; padding: 20px; color: var(--primary); }
    .container { max-width: 900px; margin: 0 auto; }
    .header-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    
    .card { background: white; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); overflow: hidden; }
    .log-item { padding: 20px; border-bottom: 1px solid #edf2f7; display: flex; justify-content: space-between; align-items: center; transition: background 0.2s; }
    .log-item:hover { background: #f8fafc; }
    
    .log-info { line-height: 1.4; }
    .log-time { font-size: 0.75rem; color: #718096; font-weight: bold; text-transform: uppercase; margin-bottom: 4px; }
    .log-email { font-size: 1rem; font-weight: 700; color: var(--primary); }
    .log-type { font-size: 0.8rem; color: var(--accent); font-weight: bold; }

    .map-btn { 
      background: #3182ce; color: white; padding: 10px 18px; 
      text-decoration: none; border-radius: 6px; font-size: 0.8rem; 
      font-weight: bold; display: flex; align-items: center; gap: 8px;
      box-shadow: 0 2px 4px rgba(49, 130, 206, 0.3);
    }
    .back-btn { color: var(--primary); text-decoration: none; font-weight: bold; font-size: 0.9rem; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header-bar">
        <h2>GPS Activity Audit</h2>
        <a href="index.html" class="back-btn">← RETURN TO DASHBOARD</a>
    </div>

    <div id="logContent" class="card">
        <div style="padding:40px; text-align:center; color: #718096;">Connecting to Ancestry Engine...</div>
    </div>
  </div>

  <script>
    // UPDATED DEPLOYMENT ID: Version 134
    const scriptURL = 'https://script.google.com/macros/s/AKfycbxqwDS9Jufsc_2uJkYfjjcLI5QQhcapCCtaq5VgP3o8mAhhxWwcy6051sHGWsmmS2St/exec';
    
    async function loadLogs() {
        try {
            const res = await fetch(scriptURL + "?action=getActivity"); 
            const data = await res.json();
            
            const container = document.getElementById('logContent');
            if(!data || data.length === 0) {
                container.innerHTML = '<div style="padding:60px; text-align:center; color: #718096;">No GPS activity recorded in the last 30 days.</div>';
                return;
            }

            container.innerHTML = data.map(log => `
                <div class="log-item">
                    <div class="log-info">
                        <div class="log-time">${new Date(log.time).toLocaleString()}</div>
                        <div class="log-email">${log.email}</div>
                        <div class="log-type">📍 SITE VERIFIED: #${log.jobId || 'N/A'}</div>
                    </div>
                    <a href="${log.map}" target="_blank" class="map-btn">VIEW ON GOOGLE MAPS</a>
                </div>
            `).join('');
        } catch (e) {
            document.getElementById('logContent').innerHTML = '<div style="padding:40px; text-align:center; color: red;">Failed to sync GPS logs. Verify script deployment.</div>';
        }
    }
    window.onload = loadLogs;
  </script>
</body>
</html>
